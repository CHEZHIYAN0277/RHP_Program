public class DigitCheck {
    public static void main(String[] args) {
        String str = "0123456789";

        int flag = 0;

        for (int i = 0; i < str.length(); i++) {
            char ch = str.charAt(i);

            if (ch >= '0' && ch <= '9') {
                flag = flag | (1 << (ch - '0'));
            }
        }

        if (flag == (1 << 10) - 1)
            System.out.println("All digits present");
        else
            System.out.println("Missing digits");
    }
}
